# ─────────────────────────────────────────────────────────────────────────────
# PMS — Pradeep Medical Store — Environment Variables Example
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# Database — PostgreSQL (Neon/Supabase/Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DBNAME?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Auth secret — HMAC token signing (generate: openssl rand -hex 32)
AUTH_SECRET="generate-a-32-byte-hex-string-here"

# Cookie secure flag — true in production (HTTPS), false for localhost
COOKIE_SECURE="false"

# Site URL (used in emails + notifications)
ADMIN_URL="https://yourdomain.com/admin"

# Z.AI SDK (AI Assistant + Marketing) — optional, has hardcoded fallback
Z_AI_BASE_URL="https://internal-api.z.ai/v1"
Z_AI_API_KEY="your-zai-api-key"
Z_AI_CHAT_ID="your-zai-chat-id"
Z_AI_USER_ID="your-zai-user-id"

# Web Push (VAPID) — for App Notifications (generate: bun run scripts/gen-vapid.mjs)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Node environment
NODE_ENV="development"
